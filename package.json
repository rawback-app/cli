{
  "name": "@rawback/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Rawback CLI for humans and AI agents",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --minify --outfile dist/rawback src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run test && bun run lint && bun run format:check && bun run build",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.35",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
